# Modelo do backend/.env.
# Não precisa copiar na mão: `npm run setup` (na raiz) cria o .env a partir
# deste arquivo e já gera os segredos JWT.

# ─── Servidor ─────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Banco de dados (SQLite) ──────────────────
# Caminho relativo a backend/src/prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ─── JWT ──────────────────────────────────────
# O setup substitui os valores abaixo por segredos aleatórios.
# Para gerar na mão: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque_por_secret_forte_aqui
JWT_REFRESH_SECRET=troque_por_outro_secret_forte_aqui
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Frontend ─────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── OpenAI (opcional) ────────────────────────
# Vazio = simulador local de IA (funciona offline).
# Para usar o GPT-4o, cole uma chave real que comece com sk-.
OPENAI_API_KEY=

# ─── Logs ─────────────────────────────────────
LOG_LEVEL=info

# ─── Base da IA e teste público ───────────────
# true = a médica pode editar a Base da IA (local e notebook do stand).
# Qualquer outro valor ou ausente = só leitura (Render, Docker).
KB_EDIT=true
# Requisições por minuto por IP em /api/public (o stand sai por um IP só)
PUBLIC_RATE_LIMIT=300

# ─── Feira ────────────────────────────────────
# true = entrar só com o nome e "Entrar como médica", sem senha.
# Ausente ou false = só login com usuário e senha (padrão em produção/Render).
DEMO_MODE=true
